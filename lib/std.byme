// ByteMe Standard Library: Core

// Error is the base struct for all custom errors.
struct Error {
    message: string,
    code: int
}

fn (e: Error) toString() -> string {
    return "Error[" + e.code + "]: " + e.message;
}

// Global helper to throw a custom error
fn panic(msg) {
    throw Error(msg, 1);
}
