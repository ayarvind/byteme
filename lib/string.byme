// ByteMe Standard Library: String
// This module provides common string manipulation functions organized within a struct.

struct StringUtility {}

// Returns the string in all lowercase
fn (u: StringUtility) toLower(s: string) -> string { return strToLower(s); }

// Returns the string in all uppercase
fn (u: StringUtility) toUpper(s: string) -> string { return strToUpper(s); }

// Returns a slice of the string with all leading and trailing 
// characters contained in cutset removed.
fn (u: StringUtility) trim(s: string, cutset: string) -> string { return strTrim(s, cutset); }

// Returns a slice of the string with all leading characters 
// contained in cutset removed.
fn (u: StringUtility) trimLeft(s: string, cutset: string) -> string { return strTrimLeft(s, cutset); }

// Returns a slice of the string with all trailing characters 
// contained in cutset removed.
fn (u: StringUtility) trimRight(s: string, cutset: string) -> string { return strTrimRight(s, cutset); }

// Returns a slice of the string with all leading and trailing 
// white space removed.
fn (u: StringUtility) trimSpace(s: string) -> string { return strTrimSpace(s); }

// Slices s into all substrings separated by sep and returns a list 
// of the substrings between those separators.
fn (u: StringUtility) split(s: string, sep: string) -> array { return strSplit(s, sep); }

// Splits the string s around each instance of one or more consecutive 
// white space characters.
fn (u: StringUtility) fields(s: string) -> array { return strFields(s); }

// Concatenates the elements of its first argument to create a single string. 
// The separator string sep is placed between elements in the resulting string.
fn (u: StringUtility) join(arr: array, sep: string) -> string { return strJoin(arr, sep); }

// Reports whether substr is within s.
fn (u: StringUtility) contains(s: string, substr: string) -> bool { return strContains(s, substr); }

// Tests whether the string s begins with prefix.
fn (u: StringUtility) hasPrefix(s: string, prefix: string) -> bool { return strHasPrefix(s, prefix); }
fn (u: StringUtility) startsWith(s: string, prefix: string) -> bool { return strHasPrefix(s, prefix); }

// Tests whether the string s ends with suffix.
fn (u: StringUtility) hasSuffix(s: string, suffix: string) -> bool { return strHasSuffix(s, suffix); }
fn (u: StringUtility) endsWith(s: string, suffix: string) -> bool { return strHasSuffix(s, suffix); }

// Returns the index of the first instance of substr in s, or -1 if substr is not present in s.
fn (u: StringUtility) indexOf(s: string, substr: string) -> int { return strIndex(s, substr); }

// Returns the index of the last instance of substr in s, or -1 if substr is not present in s.
fn (u: StringUtility) lastIndexOf(s: string, substr: string) -> int { return strLastIndex(s, substr); }

// Returns the number of non-overlapping instances of substr in s.
fn (u: StringUtility) count(s: string, substr: string) -> int { return strCount(s, substr); }

// Returns a copy of the string s with the first n non-overlapping instances of old replaced by new.
// If n < 0, there is no limit on the number of replacements.
fn (u: StringUtility) replace(s: string, old: string, new: string, n: int) -> string { return strReplace(s, old, new, n); }

// Returns a copy of the string s with all non-overlapping instances of old replaced by new.
fn (u: StringUtility) replaceAll(s: string, old: string, new: string) -> string { return strReplace(s, old, new, -1); }

// Returns a new string consisting of n copies of s.
fn (u: StringUtility) repeat(s: string, n: int) -> string { return strRepeat(s, n); }

// Returns a new string with characters in reverse order.
fn (u: StringUtility) reverse(s: string) -> string {
    return strReverse(s);
}

// Capitalizes the first letter of the string.
fn (u: StringUtility) capitalize(s: string) -> string {
    if (len(s) == 0) { return s; }
    return strToUpper(toString(charAt(s, 0))) + u.substring(s, 1, len(s));
}

// Returns true if all characters in the string are alphabetic.
fn (u: StringUtility) isAlpha(s: string) -> bool { return strIsAlpha(s); }

// Returns true if all characters in the string are digits.
fn (u: StringUtility) isDigit(s: string) -> bool { return strIsDigit(s); }

// Returns true if all characters in the string are whitespace.
fn (u: StringUtility) isSpace(s: string) -> bool { return strIsSpace(s); }

// Pads the string with padChar on the left until it reaches length n.
fn (u: StringUtility) padLeft(s: string, n: int, padChar: string) -> string {
    let diff = n - len(s);
    if (diff <= 0) { return s; }
    return strRepeat(padChar, diff) + s;
}

// Pads the string with padChar on the right until it reaches length n.
fn (u: StringUtility) padRight(s: string, n: int, padChar: string) -> string {
    let diff = n - len(s);
    if (diff <= 0) { return s; }
    return s + strRepeat(padChar, diff);
}

// Returns a substring of s from start up to (but not including) end.
fn (u: StringUtility) substring(s: string, start: int, end: int) -> string {
    if (start < 0) { start = 0; }
    if (end > len(s)) { end = len(s); }
    if (start >= end) { return ""; }
    
    let res = "";
    let i = start;
    while (i < end) {
        res = res + toString(charAt(s, i));
        i = i + 1;
    }
    return res;
}

// Global instance for the String utility methods
let String = StringUtility();
