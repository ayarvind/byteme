// ByteMe Standard Library: String
// This module provides common string manipulation functions.

// Returns the string in all lowercase
fn toLower(s) { return strToLower(s); }

// Returns the string in all uppercase
fn toUpper(s) { return strToUpper(s); }

// Returns a slice of the string with all leading and trailing 
// characters contained in cutset removed.
fn trim(s, cutset) { return strTrim(s, cutset); }

// Returns a slice of the string with all leading characters 
// contained in cutset removed.
fn trimLeft(s, cutset) { return strTrimLeft(s, cutset); }

// Returns a slice of the string with all trailing characters 
// contained in cutset removed.
fn trimRight(s, cutset) { return strTrimRight(s, cutset); }

// Returns a slice of the string with all leading and trailing 
// white space removed.
fn trimSpace(s) { return strTrimSpace(s); }

// Slices s into all substrings separated by sep and returns a list 
// of the substrings between those separators.
fn split(s, sep) { return strSplit(s, sep); }

// Splits the string s around each instance of one or more consecutive 
// white space characters.
fn fields(s) { return strFields(s); }

// Concatenates the elements of its first argument to create a single string. 
// The separator string sep is placed between elements in the resulting string.
fn join(arr, sep) { return strJoin(arr, sep); }

// Reports whether substr is within s.
fn contains(s, substr) { return strContains(s, substr); }

// Tests whether the string s begins with prefix.
fn hasPrefix(s, prefix) { return strHasPrefix(s, prefix); }
fn startsWith(s, prefix) { return strHasPrefix(s, prefix); }

// Tests whether the string s ends with suffix.
fn hasSuffix(s, suffix) { return strHasSuffix(s, suffix); }
fn endsWith(s, suffix) { return strHasSuffix(s, suffix); }

// Returns the index of the first instance of substr in s, or -1 if substr is not present in s.
fn indexOf(s, substr) { return strIndex(s, substr); }

// Returns the index of the last instance of substr in s, or -1 if substr is not present in s.
fn lastIndexOf(s, substr) { return strLastIndex(s, substr); }

// Returns the number of non-overlapping instances of substr in s.
fn count(s, substr) { return strCount(s, substr); }

// Returns a copy of the string s with the first n non-overlapping instances of old replaced by new.
// If n < 0, there is no limit on the number of replacements.
fn replace(s, old, new, n) { return strReplace(s, old, new, n); }

// Returns a copy of the string s with all non-overlapping instances of old replaced by new.
fn replaceAll(s, old, new) { return strReplace(s, old, new, -1); }

// Returns a new string consisting of n copies of s.
fn repeat(s, n) { return strRepeat(s, n); }

// Returns a new string with characters in reverse order.
fn reverse(s) {
    return strReverse(s);
}

// Capitalizes the first letter of the string.
fn capitalize(s) {
    if (len(s) == 0) { return s; }
    return strToUpper(charAt(s, 0)) + substring(s, 1, len(s));
}

// Returns true if all characters in the string are alphabetic.
fn isAlpha(s) { return strIsAlpha(s); }

// Returns true if all characters in the string are digits.
fn isDigit(s) { return strIsDigit(s); }

// Returns true if all characters in the string are whitespace.
fn isSpace(s) { return strIsSpace(s); }

// Pads the string with padChar on the left until it reaches length n.
fn padLeft(s, n, padChar) {
    let diff = n - len(s);
    if (diff <= 0) { return s; }
    return strRepeat(padChar, diff) + s;
}

// Pads the string with padChar on the right until it reaches length n.
fn padRight(s, n, padChar) {
    let diff = n - len(s);
    if (diff <= 0) { return s; }
    return s + strRepeat(padChar, diff);
}

// Returns a substring of s from start up to (but not including) end.
fn substring(s, start, end) {
    if (start < 0) { start = 0; }
    if (end > len(s)) { end = len(s); }
    if (start >= end) { return ""; }
    
    // Use optimized slice if possible, but for now loop is safe
    let res = "";
    let i = start;
    while (i < end) {
        // Use the global charAt builtin
        res = res + charAt(s, i);
        i = i + 1;
    }
    return res;
}
