// ByteMe Standard Library: Algorithm
// Provides common algorithms like sorting and searching.

// Sorts an array in-place. Accepts optional comparator function.
fn sort(arr, comparator) {
    if (comparator == null) {
        return arraySort(arr);
    }
    return arraySort(arr, comparator);
}

// Returns a new sorted array. Accepts optional comparator function.
fn sorted(arr, comparator) {
    let newArr = arraySlice(arr, 0, len(arr));
    if (comparator == null) {
        return arraySort(newArr);
    }
    return arraySort(newArr, comparator);
}

// ── Functional Programming (Higher-Order Functions) ────────────────────

// Transforms an array using a callback function
fn algoMap(arr, callback) {
    let res = [];
    let i = 0;
    let n = len(arr);
    while (i < n) {
        arrayPush(res, callback(arr[i]));
        i = i + 1;
    }
    return res;
}

// Filters an array based on a predicate function
fn algoFilter(arr, predicate) {
    let res = [];
    let i = 0;
    let n = len(arr);
    while (i < n) {
        if (predicate(arr[i])) {
            arrayPush(res, arr[i]);
        }
        i = i + 1;
    }
    return res;
}

// Reduces an array to a single value using an accumulator function
fn algoReduce(arr, callback, initial) {
    let acc = initial;
    let i = 0;
    let n = len(arr);
    while (i < n) {
        acc = callback(acc, arr[i]);
        i = i + 1;
    }
    return acc;
}

// Returns true if all elements satisfy the predicate
fn every(arr, predicate) {
    let i = 0;
    let n = len(arr);
    while (i < n) {
        if (!predicate(arr[i])) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Returns true if at least one element satisfies the predicate
fn some(arr, predicate) {
    let i = 0;
    let n = len(arr);
    while (i < n) {
        if (predicate(arr[i])) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Performs a linear search, returns index or -1
fn find(arr, target) {
    let i = 0;
    let n = len(arr);
    while (i < n) {
        if (arr[i] == target) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn contains(arr, target) {
    return find(arr, target) != -1;
}

// Reverses an array in-place
fn reverse(arr) {
    let i = 0;
    let j = len(arr) - 1;
    while (i < j) {
        let temp = arr[i];
        arr[i] = arr[j];
        arr[j] = temp;
        i = i + 1;
        j = j - 1;
    }
    return arr;
}

// Counts occurrences of target in arr
fn count(arr, target) {
    let c = 0;
    let i = 0;
    let n = len(arr);
    while (i < n) {
        if (arr[i] == target) {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}
