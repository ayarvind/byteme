// ByteMe Standard Library: Time
// Provides date and time manipulation utilities.

struct TimeUtility {}

// Returns current Unix timestamp
fn (u: TimeUtility) now() {
    return timeNow();
}

// Sleeps for n seconds
fn (u: TimeUtility) sleep(seconds) {
    timeSleep(seconds);
}

// Formats a Unix timestamp using a Go-style layout string
fn (u: TimeUtility) format(timestamp, layout) {
    return timeFormat(timestamp, layout);
}

// Parses a time string into a Unix timestamp
fn (u: TimeUtility) parse(layout, value) {
    return timeParse(layout, value);
}

// Global instance
let Time = TimeUtility();

// Common Layouts
const ANSIC       = "Mon Jan _2 15:04:05 2006";
const RFC822      = "02 Jan 06 15:04 MST";
const RFC3339     = "2006-01-02T15:04:05Z07:00";
const DATE_ONLY   = "2006-01-02";
const TIME_ONLY   = "15:04:05";
