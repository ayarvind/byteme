// ByteMe Standard Library: HTTP
// Provides a clean, object-oriented interface for making HTTP requests.

// Response represents the result of an HTTP request.
struct Response {
    status: int,
    body: string,
    headers: any
}

// json parses the response body as a ByteMe object (map or array).
fn (r: Response) json() -> any {
    return jsonParse(r.body);
}

// isOk returns true if the status code indicates success (2xx).
fn (r: Response) isOk() -> bool {
    if (r.status < 200) { return false; }
    if (r.status >= 300) { return false; }
    return true;
}

// HttpUtility provides methods for making HTTP requests.
struct HttpUtility {}

// request performs a generic HTTP request with a specified method.
fn (u: HttpUtility) request(method, url, body, headers) -> Response {
    let payload = body;
    let t = typeof(body);
    if (t == "map" || t == "array") {
        payload = jsonStringify(body);
    }
    
    let res = httpDo(method, url, payload, headers);
    if (typeof(res) == "ERROR") {
        return Response(0, toString(res), map());
    }
    return Response(res.status, res.body, res.headers);
}

// get performs an HTTP GET request.
fn (u: HttpUtility) get(url) -> Response {
    return u.request("GET", url, "", map());
}

// post performs an HTTP POST request.
fn (u: HttpUtility) post(url, body) -> Response {
    return u.request("POST", url, body, map());
}

// put performs an HTTP PUT request.
fn (u: HttpUtility) put(url, body) -> Response {
    return u.request("PUT", url, body, map());
}

// patch performs an HTTP PATCH request.
fn (u: HttpUtility) patch(url, body) -> Response {
    return u.request("PATCH", url, body, map());
}

// delete performs an HTTP DELETE request.
fn (u: HttpUtility) delete(url) -> Response {
    return u.request("DELETE", url, "", map());
}

// options performs an HTTP OPTIONS request.
fn (u: HttpUtility) options(url) -> Response {
    return u.request("OPTIONS", url, "", map());
}

// urlWithParams appends query parameters to a base URL.
fn (u: HttpUtility) urlWithParams(baseUrl, params) -> string {
    let query = "";
    let keys = mapKeys(params);
    let i = 0;
    while (i < len(keys)) {
        let key = keys[i];
        let val = toString(mapGet(params, key));
        query = query + (i > 0 ? "&" : "") + key + "=" + val;
        i = i + 1;
    }
    
    return len(query) > 0 ? baseUrl + "?" + query : baseUrl;
}

// Export the Http utility
let Http = HttpUtility();
