// ByteMe Standard Library: Map
// Provides an OOP-style wrapper for the built-in map type.

struct MapUtility {}

struct Map {
    data: any
}

fn (u: MapUtility) new() -> Map {
    return Map(map());
}

fn (m: Map) put(key, val) -> void {
    mapSet(m.data, key, val);
}

fn (m: Map) get(key) -> any {
    return mapGet(m.data, key);
}

fn (m: Map) has(key) -> bool {
    return mapHas(m.data, key);
}

fn (m: Map) remove(key) -> void {
    mapDelete(m.data, key);
}

fn (m: Map) keys() -> array {
    return mapKeys(m.data);
}

fn (m: Map) values() -> array {
    return mapValues(m.data);
}

fn (m: Map) size() -> int {
    return len(mapKeys(m.data));
}

fn (m: Map) clear() -> void {
    m.data = map();
}

let Maps = MapUtility();
