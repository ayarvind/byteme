// ByteMe Standard Library: Map
// Provides an OOP-style wrapper for the built-in map type.

struct MapWrapper {
    data: any
}

fn mapNew() {
    return MapWrapper(map());
}

fn mapPut(m: MapWrapper, key, val) {
    mapSet(m.data, key, val);
}

fn mapGet(m: MapWrapper, key) {
    return mapGet(m.data, key);
}

fn mapHas(m: MapWrapper, key) {
    return mapHas(m.data, key);
}

fn mapRemove(m: MapWrapper, key) {
    mapDelete(m.data, key);
}

fn mapKeys(m: MapWrapper) {
    return mapKeys(m.data);
}

fn mapValues(m: MapWrapper) {
    return mapValues(m.data);
}

fn mapSize(m: MapWrapper) {
    return len(mapKeys(m.data));
}

fn mapClear(m: MapWrapper) {
    m.data = map();
}
