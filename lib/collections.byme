// ByteMe Standard Library: Collections
// Provides data structures like List (Vector), Stack, and Queue.

// ── List (Dynamic Array / Vector) ──────────────────────────────────────
struct List {
    items: any
}

fn listNew() {
    return List([]);
}

fn listAdd(list: List, item) {
    arrayPush(list.items, item);
}

fn listGet(list: List, index) {
    return list.items[index];
}

fn listSize(list: List) {
    return len(list.items);
}

fn listClear(list: List) {
    list.items = [];
}

// ── Stack (LIFO) ────────────────────────────────────────────────────────
struct Stack {
    items: any
}

fn stackNew() {
    return Stack([]);
}

fn stackPush(s: Stack, item) {
    arrayPush(s.items, item);
}

fn stackPop(s: Stack) {
    return arrayPop(s.items);
}

fn stackPeek(s: Stack) {
    let n = len(s.items);
    if (n == 0) { return null; }
    return s.items[n-1];
}

fn stackIsEmpty(s: Stack) {
    return len(s.items) == 0;
}

// ── Queue (FIFO) ────────────────────────────────────────────────────────
struct Queue {
    items: any
}

fn queueNew() {
    return Queue([]);
}

fn queueEnqueue(q: Queue, item) {
    arrayPush(q.items, item);
}

fn queueDequeue(q: Queue) {
    if (len(q.items) == 0) { return null; }
    let item = q.items[0];
    q.items = arraySlice(q.items, 1, len(q.items));
    return item;
}

fn queuePeek(q: Queue) {
    if (len(q.items) == 0) { return null; }
    return q.items[0];
}
