// ByteMe Standard Library: Collections
// Provides data structures like List (Vector), Stack, and Queue.

struct CollectionsUtility {}

// ── List (Dynamic Array / Vector) ──────────────────────────────────────
struct List {
    items: any
}

fn (u: CollectionsUtility) newList() -> List {
    return List([]);
}

fn (list: List) add(item) -> void {
    arrayPush(list.items, item);
}

fn (list: List) get(index) -> any {
    return list.items[index];
}

fn (list: List) size() -> int {
    return len(list.items);
}

fn (list: List) clear() -> void {
    list.items = [];
}

// ── Stack (LIFO) ────────────────────────────────────────────────────────
struct Stack {
    items: any
}

fn (u: CollectionsUtility) newStack() -> Stack {
    return Stack([]);
}

fn (s: Stack) push(item) -> void {
    arrayPush(s.items, item);
}

fn (s: Stack) pop() -> any {
    return arrayPop(s.items);
}

fn (s: Stack) peek() -> any {
    let n = len(s.items);
    if (n == 0) { return null; }
    return s.items[n-1];
}

fn (s: Stack) isEmpty() -> bool {
    return len(s.items) == 0;
}

// ── Queue (FIFO) ────────────────────────────────────────────────────────
struct Queue {
    items: any
}

fn (u: CollectionsUtility) newQueue() -> Queue {
    return Queue([]);
}

fn (q: Queue) enqueue(item) -> void {
    arrayPush(q.items, item);
}

fn (q: Queue) dequeue() -> any {
    if (len(q.items) == 0) { return null; }
    let item = q.items[0];
    q.items = arraySlice(q.items, 1, len(q.items));
    return item;
}

fn (q: Queue) peek() -> any {
    if (len(q.items) == 0) { return null; }
    return q.items[0];
}

let Collections = CollectionsUtility();
