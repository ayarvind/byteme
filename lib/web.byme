// ByteMe Web Framework
// Provides utilities for building web applications and APIs.

import "lib/string.byme"

// Simple template engine that replaces {{ key }} with value from context
fn webRender(template, context) {
    let output = template;
    let keys = mapKeys(context);
    let i = 0;
    while (i < len(keys)) {
        let key = keys[i];
        let val = mapGet(context, key);
        let placeholder = "{{" + key + "}}";
        
        let strVal = "";
        if (typeof(val) == "STRING") {
            strVal = val;
        } else {
            if (typeof(val) == "INTEGER") {
                strVal = itoa(val);
            } else {
                if (typeof(val) == "FLOAT") {
                    strVal = ftoa(val);
                } else {
                    strVal = jsonStringify(val);
                }
            }
        }
        
        output = replaceAll(output, placeholder, strVal);
        i = i + 1;
    }
    return output;
}

fn webJson(data) {
    return httpResponse(200, jsonStringify(data), "application/json");
}

fn webHtml(body) {
    return httpResponse(200, body, "text/html");
}

fn webRedirect(url) {
    let res = map();
    mapSet(res, "status", 302);
    mapSet(res, "body", "");
    let headers = map();
    mapSet(headers, "Location", url);
    mapSet(res, "headers", headers);
    return res;
}

// Router helper
struct App {
    port: int
}

fn webNewApp(port) {
    return App(port);
}

fn webRoute(app, path, handler) {
    httpHandle(path, handler);
}

fn webStart(app) {
    httpServe(app.port);
}
