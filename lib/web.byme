// ByteMe Web Framework
// Provides utilities for building web applications and APIs.

struct WebUtility {}

// Simple template engine that replaces {{ key }} with value from context
fn (u: WebUtility) render(template, context) {
    let output = template;
    let keys = mapKeys(context);
    let i = 0;
    while (i < len(keys)) {
        let key = keys[i];
        let val = mapGet(context, key);
        let placeholder = "{{" + key + "}}";
        
        let strVal = toString(val);
        output = strReplace(output, placeholder, strVal, -1);
        i = i + 1;
    }
    return output;
}

fn (u: WebUtility) json(data) {
    return httpResponse(200, jsonStringify(data), "application/json");
}

fn (u: WebUtility) html(body) {
    return httpResponse(200, body, "text/html");
}

fn (u: WebUtility) redirect(url) {
    let res = map();
    mapSet(res, "status", 302);
    mapSet(res, "body", "");
    let headers = map();
    mapSet(headers, "Location", url);
    mapSet(res, "headers", headers);
    return res;
}

// Router helper
struct App {
    port: int
}

fn appNew(port) {
    return App(port);
}

fn (app: App) route(path, handler) {
    httpHandle(path, handler);
}

fn (app: App) start() {
    httpServe(app.port);
}

let Web = WebUtility();
