// ByteMe Standard Library: Set
// Provides a Set data structure for unique value storage.

struct SetUtility {}

struct Set {
    data: any
}

fn (u: SetUtility) new() -> Set {
    return Set(map());
}

fn (s: Set) add(val) -> void {
    mapSet(s.data, val, true);
}

fn (s: Set) remove(val) -> void {
    mapDelete(s.data, val);
}

fn (s: Set) has(val) -> bool {
    return mapHas(s.data, val);
}

fn (s: Set) size() -> int {
    return len(mapKeys(s.data));
}

fn (s: Set) clear() -> void {
    s.data = map();
}

fn (s: Set) toArray() -> array {
    return mapKeys(s.data);
}

// Mathematical Set Operations

fn (s: Set) union(other: Set) -> Set {
    let res = SetUtility().new();
    let keysA = s.toArray();
    let keysB = other.toArray();
    
    let i = 0;
    while (i < len(keysA)) {
        res.add(keysA[i]);
        i = i + 1;
    }
    
    i = 0;
    while (i < len(keysB)) {
        res.add(keysB[i]);
        i = i + 1;
    }
    return res;
}

fn (s: Set) intersect(other: Set) -> Set {
    let res = SetUtility().new();
    let keysA = s.toArray();
    let i = 0;
    while (i < len(keysA)) {
        if (other.has(keysA[i])) {
            res.add(keysA[i]);
        }
        i = i + 1;
    }
    return res;
}

let Sets = SetUtility();
