// ByteMe Standard Library: Set
// Provides a Set data structure for unique value storage.

public namespace Set{

    public struct Set {
        data: any
    }

    public fn new() {
        return Set(map());
    }

    public fn add(s: Set, val) {
        mapSet(s.data, val, true);
    }

    public fn remove(s: Set, val) {
        mapDelete(s.data, val);
    }

    public fn has(s: Set, val) {
        return mapHas(s.data, val);
    }

    public fn size(s: Set) {
        return len(mapKeys(s.data));
    }

    public fn clear(s: Set) {
        s.data = map();
    }

    public fn toArray(s: Set) {
        return mapKeys(s.data);
    }

    // Mathematical Set Operations
    
    public fn union(a: Set, b: Set) {
        let res = new();
        let keysA = toArray(a);
        let keysB = toArray(b);
        
        let i = 0;
        while (i < len(keysA)) {
            add(res, keysA[i]);
            i = i + 1;
        }
        
        i = 0;
        while (i < len(keysB)) {
            add(res, keysB[i]);
            i = i + 1;
        }
        return res;
    }

    public fn intersect(a: Set, b: Set) {
        let res = new();
        let keysA = toArray(a);
        let i = 0;
        while (i < len(keysA)) {
            if (has(b, keysA[i])) {
                add(res, keysA[i]);
            }
            i = i + 1;
        }
        return res;
    }
}
