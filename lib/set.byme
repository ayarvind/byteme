// ByteMe Standard Library: Set
// Provides a Set data structure for unique value storage.

struct Set {
    data: any
}

fn setNew() {
    return Set(map());
}

fn setAdd(s: Set, val) {
    mapSet(s.data, val, true);
}

fn setRemove(s: Set, val) {
    mapDelete(s.data, val);
}

fn setHas(s: Set, val) {
    return mapHas(s.data, val);
}

fn setSize(s: Set) {
    return len(mapKeys(s.data));
}

fn setClear(s: Set) {
    s.data = map();
}

fn setToArray(s: Set) {
    return mapKeys(s.data);
}

// Mathematical Set Operations

fn setUnion(a: Set, b: Set) {
    let res = setNew();
    let keysA = setToArray(a);
    let keysB = setToArray(b);
    
    let i = 0;
    while (i < len(keysA)) {
        setAdd(res, keysA[i]);
        i = i + 1;
    }
    
    i = 0;
    while (i < len(keysB)) {
        setAdd(res, keysB[i]);
        i = i + 1;
    }
    return res;
}

fn setIntersect(a: Set, b: Set) {
    let res = setNew();
    let keysA = setToArray(a);
    let i = 0;
    while (i < len(keysA)) {
        if (setHas(b, keysA[i])) {
            setAdd(res, keysA[i]);
        }
        i = i + 1;
    }
    return res;
}
