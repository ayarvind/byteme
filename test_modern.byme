println("--- Compound Assignments ---");
let x = 10;
x += 5;
println("x (10 += 5): " + x);
x -= 3;
println("x (15 -= 3): " + x);
x *= 2;
println("x (12 *= 2): " + x);
x /= 4;
println("x (24 /= 4): " + x);

let arr = [10, 20];
arr[0] += 100;
println("arr[0] (10 += 100): " + arr[0]);

struct Point { x: int }
let p = Point(50);
p.x += 10;
println("p.x (50 += 10): " + p.x);

println("\n--- Pipeline Operator ---");
let reverse = (s: string) => strReverse(s);
let upper = (s: string) => strToUpper(s);

// Simple pipe
let res1 = "hello" |> reverse();
println("res1 (hello |> reverse): " + res1);

// Chained pipe
let res2 = "world" |> reverse() |> upper();
println("res2 (world |> reverse |> upper): " + res2);

// Pipe into builtin (if wrapped)
let shout = (s: string) => s + "!!!";
let res3 = "wow" |> shout();
println("res3 (wow |> shout): " + res3);

// Pipe into function with existing args
let addSuffix = (s: string, suffix: string) => s + suffix;
let res4 = "file" |> addSuffix(".txt");
println("res4 (file |> addSuffix(.txt)): " + res4);

println("\n--- Enums with Associated Values ---");
enum Shape {
    Circle(float),
    Rect(float, float),
    Point
}

let c = Shape.Circle(15.5);
let r = Shape.Rect(10.0, 20.0);
let p = Shape.Point;

println("Circle: " + c);
println("Rect: " + r);
println("Point: " + p);
