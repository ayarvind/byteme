import "lib/time.byme"

println("=== ByteMe Advanced Features Test ===");

// ── 1. Function Closures ──────────────────────────────────────────────────
println("\n1. Function Closures:");
fn makeAdder(x: any) {
    return fn(y: any) {
        return x + y;
    };
}

let add5 = makeAdder(5);
let add10 = makeAdder(10);

println("   5 + 2  =", add5(2));
println("   10 + 2 =", add10(2));

fn counter() {
    let count = 0;
    return fn() {
        count = count + 1;
        return count;
    };
}

let c = counter();
println("   Count 1:", c());
println("   Count 2:", c());
println("   Count 3:", c());

// ── 2. Map Key Recovery ───────────────────────────────────────────────────
println("\n2. Map Key Recovery:");
let m = map();
let k1 = map();
mapSet(k1, "id", 1);
let k2 = [1, 2, 3];

mapSet(m, k1, "Object Key");
mapSet(m, k2, "Array Key");

println("   Keys type recovery:");
let keys = mapKeys(m);
let i = 0;
while (i < len(keys)) {
    println("   Key", i, ":", keys[i], "Type:", typeof(keys[i]));
    i = i + 1;
}

// ── 3. Time Module Enhancements ───────────────────────────────────────────
println("\n3. Time Enhancements:");
let now = Time.now();
println("   Now (Unix) :", now);

let later = timeAdd(now, 3600); // +1 hour
println("   +1 Hour    :", Time.format(later, Time.RFC3339));

let diff = timeDiff(later, now);
println("   Diff (sec) :", diff);

let tokyo = timeInLocation(now, "Asia/Tokyo");
println("   Tokyo Time :", tokyo);

let london = timeInLocation(now, "Europe/London");
println("   London Time:", london);

println("\n=== Advanced Features Test Complete ===");
