// Binary Search Tree (BST) Implementation in ByteMe

struct Node {
    val: int,
    left: any,
    right: any
}

public namespace BST {
    let root = null;

    public fn insert(v: int) {
        if (root == null) {
            root = Node(v, null, null);
            println("Root created with value:", v);
        } else {
            insertNode(root, v);
        }
        return 0;
    }

    // Recursive helper for insertion
    fn insertNode(node: any, v: int) {
        if (v < node.val) {
            if (node.left == null) {
                node.left = Node(v, null, null);
                println("Inserted", v, "to the left of", node.val);
            } else {
                insertNode(node.left, v);
            }
        } else {
            if (node.right == null) {
                node.right = Node(v, null, null);
                println("Inserted", v, "to the right of", node.val);
            } else {
                insertNode(node.right, v);
            }
        }
        return 0;
    }

    public fn search(v: int) -> bool {
        return searchNode(root, v);
    }

    // Recursive helper for searching
    fn searchNode(node: any, v: int) -> bool {
        if (node == null) { return false; }
        if (v == node.val) { return true; }
        
        if (v < node.val) {
            return searchNode(node.left, v);
        } else {
            return searchNode(node.right, v);
        }
    }

    public fn printInOrder() {
        println("In-Order Traversal (should be sorted):");
        traverse(root);
        return 0;
    }

    // Recursive helper for traversal
    fn traverse(node: any) {
        if (node != null) {
            traverse(node.left);
            println("Node:", node.val);
            traverse(node.right);
        }
        return 0;
    }
}

// --- Test Suite ---

println("--- BST Demonstration ---");

BST.insert(15);
BST.insert(10);
BST.insert(20);
BST.insert(8);
BST.insert(12);
BST.insert(17);
BST.insert(25);

println("");
BST.printInOrder();

println("");
println("Search 12:", BST.search(12));   // true
println("Search 17:", BST.search(17));   // true
println("Search 100:", BST.search(100)); // false
println("Search 5:", BST.search(5));     // false
