// ============================================================
// test_http_server.byme  — ByteMe Native HTTP Server Demo
//
// Run:  byteme test_http_server.byme
// Then: curl http://localhost:3000/
//       curl http://localhost:3000/api/greet
//       curl -X POST http://localhost:3000/api/echo  -d '{"msg":"hello"}'
// ============================================================

println("=== ByteMe HTTP Server ===");

// ── Route: GET / ─────────────────────────────────────────────
fn handleRoot(req: map) -> map {
    let body = "<html><body><h1>Welcome to ByteMe!</h1><p>A language compiled to bytecode, serving HTTP requests natively.</p></body></html>";
    return httpResponse(200, body, "text/html");
}
httpHandle("/", handleRoot);

// ── Route: GET /api/greet ─────────────────────────────────────
fn handleGreet(req: map) -> map {
    let method = mapGet(req, "method");
    let path   = mapGet(req, "path");
    let query  = mapGet(req, "query");

    let payload = map();
    mapSet(payload, "message", "Hello from ByteMe!");
    mapSet(payload, "method",  method);
    mapSet(payload, "path",    path);
    mapSet(payload, "query",   query);
    mapSet(payload, "lang",    "ByteMe");
    mapSet(payload, "version", "1.0");

    let body = jsonStringify(payload);
    return httpResponse(200, body, "application/json");
}
httpHandle("/api/greet", handleGreet);

// ── Route: POST /api/echo ─────────────────────────────────────
fn handleEcho(req: map) -> map {
    let reqBody = mapGet(req, "body");

    let res = map();
    mapSet(res, "echo",      reqBody);
    mapSet(res, "received",  true);
    mapSet(res, "timestamp", timeNow());

    let body = jsonStringify(res);
    return httpResponse(200, body, "application/json");
}
httpHandle("/api/echo", handleEcho);

// ── Route: GET /api/health ────────────────────────────────────
fn handleHealth(req: map) -> map {
    let res = map();
    mapSet(res, "status",    "ok");
    mapSet(res, "uptime",    timeNow());
    mapSet(res, "server",    "ByteMe VM");
    let body = jsonStringify(res);
    return httpResponse(200, body, "application/json");
}
httpHandle("/api/health", handleHealth);

// ── Start the server (blocking) ───────────────────────────────
println("Routes registered: /, /api/greet, /api/echo, /api/health");
println("Starting server on http://localhost:3001 ...");
httpServe(3001);
