// Comprehensive Demo of ByteMe Language
// This program covers all major aspects: variables, control flow, functions, 
// closures, recursion, structs, methods, error handling, and concurrency.

namespace MathUtils {
    fn factorial(n: int) -> int {
        if (n <= 1) { return 1; }
        return n * MathUtils.factorial(n - 1);
    }

    fn fib(n: int) -> int {
        if (n < 2) { return n; }
        return MathUtils.fib(n - 1) + MathUtils.fib(n - 2);
    }
}

struct Point {
    x: float,
    y: float
}

fn (p: Point) distance() -> float {
    return mathSqrt(p.x * p.x + p.y * p.y);
}

fn main() {
    println("--- ByteMe Comprehensive Demo ---");

    // 1. Variables and Data Types
    let name = "ByteMe";
    const version = 1.1;
    let isActive = true;
    let scores = [85, 92, 78, 100];
    
    // Map usage via built-ins
    let metadata = map();
    mapSet(metadata, "author", "Antigravity");
    mapSet(metadata, "tags", ["compiler", "vm"]);

    println("Project:", name, "v", version);
    println("Active:", isActive);
    println("Scores:", scores);
    println("Metadata:", metadata);

    // 2. Control Flow
    if (len(scores) > 3) {
        println("Great! We have many scores.");
    } else {
        println("Need more data.");
    }

    let i = 0;
    println("Scores loop starting...");
    while (i < len(scores)) {
        println("Score index", i, ":", scores[i]);
        i = i + 1;
    }

    // 3. Functions and Namespaces
    println("MathUtils.factorial(5):", MathUtils.factorial(5));
    println("MathUtils.fib(10):", MathUtils.fib(10));

    // 4. Closures
    fn makeCounter(start: int) {
        let count = start;
        return fn() {
            count = count + 1;
            return count;
        };
    }

    let counter = makeCounter(10);
    println("Counter values:", counter(), counter(), counter());

    // 5. Structs and Methods
    let p1 = Point(3.0, 4.0);
    println("Point:", p1);
    println("Distance from origin:", p1.distance());

    // 6. Error Handling
    println("\nTesting Error Handling:");
    fn risky(shouldFail: bool) {
        if (shouldFail) {
            throw "A custom error occurred!";
        }
        return "Success";
    }

    try {
        println("Trying risky operation...");
        risky(true);
    } catch(err) {
        println("Caught error:", err);
    } finally {
        println("Cleanup in finally block.");
    }

    // 7. Concurrency
    println("\nTesting Concurrency:");
    fn asyncTask(id: int, delay: int) {
        println("  Task", id, "started");
        timeSleep(delay);
        println("  Task", id, "completed");
        return id * 100;
    }

    let f1 = spawn asyncTask(1, 1); // timeSleep is in seconds, so 1 second
    let f2 = spawn asyncTask(2, 2);
    
    println("Waiting for tasks to complete...");
    let res2 = await f2; 
    let res1 = await f1;
    
    println("Task 1 result:", res1);
    println("Task 2 result:", res2);

    println("\n--- Demo Finished Successfully ---");
}

main();
