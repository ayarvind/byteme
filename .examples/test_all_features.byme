// ByteMe Ultimate Feature Test
// Uses map() for structured data since VM struct instantiation is WIP.

fn fetchData(id: int) -> string {
    println("Fetching data for ID:", id);
    timeSleep(100);

    // Simulate error path
    if (id < 0) {
        throw "Invalid ID: Must be positive";
    }

    let rawJson = "{\"status\":\"success\",\"payload\":\"ByteMe is Awesome\"}";
    let parsed = jsonParse(rawJson);

    // Build a response map (struct instances are not yet in the VM)
    let res = map();
    mapSet(res, "data", mapGet(parsed, "payload"));
    mapSet(res, "status", mapGet(parsed, "status"));
    mapSet(res, "timestamp", timeNow());

    return res;
}

println("--- Starting Ultimate Test ---");

try {
    let res = fetchData(101);
    println("Data Received:", mapGet(res, "data"));
    println("Status      :", mapGet(res, "status"));
    println("Timestamp ms:", mapGet(res, "timestamp"));

    println("\nTesting Error Handling...");
    fetchData(-1);
} catch(e) {
    println("Gracefully caught expected error:", e);
} finally {
    println("\nTest Suite Completed.");
}
