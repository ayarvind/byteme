import "lib/console.byme"
import "lib/collections.byme"
import "lib/algorithm.byme"

println("=== ByteMe Standard Template Library (STL) Test ===");

// ── 1. Collections: List & Stack ──────────────────────────────
println("\n1. Collections:");
let myList = Collections.newList();
myList.add("C++");
myList.add("Go");
myList.add("ByteMe");
println("   List size  :", myList.size());
println("   List items :", myList.items);

let myStack = Collections.newStack();
myStack.push(10);
myStack.push(20);
myStack.push(30);
println("   Stack peek :", myStack.peek());
println("   Stack pop  :", myStack.pop());
println("   Stack peek after pop :", myStack.peek());

// ── 2. Algorithms ─────────────────────────────────────────────
println("\n2. Algorithms:");
let unsorted = [5, 1, 9, 3, 7];
println("   Unsorted :", unsorted);
let sorted = Algorithm.sorted(unsorted, null);
println("   Sorted   :", sorted);
println("   Find '9' in unsorted :", Algorithm.find(unsorted, 9));
println("   Reverse sorted       :", Algorithm.reverse(sorted));

// ── 3. Console (Simulation) ───────────────────────────────────
println("\n3. Console I/O:");
println("   [Note: Skipping interactive input() in automated test]");
