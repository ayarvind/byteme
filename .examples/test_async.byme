

async fn produce(ch) {
    let i = 0;
    while (i < 10) {
        let msg = "MSG_" + i;
        println("Producing:", msg);
        send(ch, msg);
        i = i + 1;
    }
    close(ch);
    return 0;
}

async fn consume(ch) {
    while (true) {
        let msg = recv(ch);
        if (msg == null) {
            break;
        }
        println("Consuming:", msg);
    }
    return 0;
}

fn main() {
    let ch = chan();
    spawn produce(ch);
    spawn consume(ch);
    return 0;
}